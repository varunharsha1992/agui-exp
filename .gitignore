# Environment files (ignore secrets, but keep checked-in examples)
**/.env
**/.env.*
!**/.env.example

# Common credential / key formats
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/id_rsa
**/id_ed25519

# Cursor local state (often includes user-specific settings)
.cursor/

# Node
node_modules/

# Python
__pycache__/
.pytest_cache/

