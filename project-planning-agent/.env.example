# Groq API (planner agent uses Groq GPT-OSS 120B)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API (optional; used by other features if needed)
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration (legacy; planner uses Groq 120B when GROQ_API_KEY is set)
AGENT_MODEL=gpt-4o

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS Configuration (comma-separated origins, or * for all)
CORS_ORIGINS=*

# Todoist MCP Server URL (for plan export feature)
MCP_SERVER_URL=http://localhost:3001/mcp

# Environment
ENVIRONMENT=development
